{
	"name": "cyberscoops-io",
	"compatibility_date": "2026-11-09",
	"observability": { "enabled": true },

	// Static site (migrated from Cloudflare Pages): no Worker script, every request is
	// served from static assets. Repository files that are not part of the site are
	// excluded in .assetsignore.
	"assets": {
		"directory": ".",
		"html_handling": "auto-trailing-slash"
	},

	// Serve only on the Custom Domain (Cloudflare manages its DNS record and certificate).
	// workers.dev and Preview URLs stay off so there is no duplicate public copy.
	"routes": [{ "pattern": "cyberscoops.io", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
